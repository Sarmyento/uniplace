---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingDetail from '../../components/listings/ListingDetail.astro';
import RevealInit from '../../components/sections/RevealInit.astro';
import CTASection from '../../components/sections/CTASection.astro';
import { getListingBySlug, getListingSlugs } from '../../lib/listings';
import { waUrl } from '../../config/site';

export function getStaticPaths() {
  const slugs = getListingSlugs();
  if (!slugs.length) return [{ params: { slug: 'exemplo' } }];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const listing = slug ? getListingBySlug(slug) : undefined;
---

{
  listing ? (
    <BaseLayout
      title={`${listing.title} | Uniplace`}
      description={listing.description || `${listing.type} em ${listing.neighborhood}, ${listing.city}.`}
      image={listing.image || undefined}
      bodyClass="page-listing-detail"
    >
      <ListingDetail listing={listing} />
      <CTASection
        title="Quer visitar este imóvel?"
        text="A Uniplace agenda com o corretor associado."
        ctaLabel="WhatsApp"
        ctaHref={waUrl(`Olá! Quero visitar o imóvel ${listing.title} (${listing.id}).`)}
      />
      <RevealInit />
    </BaseLayout>
  ) : (
    <BaseLayout title="Imóvel | Uniplace" noindex={true}>
      <section class="section">
        <div class="container">
          <h1>Imóvel não encontrado</h1>
          <p>
            <a href="/imoveis">Ver imóveis</a>
          </p>
        </div>
      </section>
    </BaseLayout>
  )
}
