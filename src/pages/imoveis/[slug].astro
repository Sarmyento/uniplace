---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getListingBySlug, getListingSlugs, formatListingAddress } from '../../lib/listings';
import { waUrl } from '../../config/site';

export function getStaticPaths() {
  const slugs = getListingSlugs();
  if (!slugs.length) return [{ params: { slug: 'exemplo' } }];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const listing = slug ? getListingBySlug(slug) : undefined;
---

{
  listing ? (
    <BaseLayout
      title={`${listing.title} | Uniplace`}
      description={listing.description || `${listing.type} em ${listing.neighborhood}, ${listing.city}.`}
    >
      <section class="section">
        <div class="container detail">
          <p class="eyebrow">
            {listing.type} · {formatListingAddress(listing)}
          </p>
          <h1>{listing.title}</h1>
          <p class="price">{listing.price}</p>
          <p class="meta">
            {[
              listing.bedrooms ? `${listing.bedrooms} quartos` : '',
              listing.suites ? `${listing.suites} suítes` : '',
              listing.area ? `${listing.area} m²` : '',
              listing.parking ? `${listing.parking} vagas` : '',
            ]
              .filter(Boolean)
              .join(' · ')}
          </p>
          {listing.image && (
            <img class="hero-img" src={listing.image} alt="" width="960" height="540" />
          )}
          {listing.description && <p>{listing.description}</p>}
          <a
            class="btn btn-primary"
            href={waUrl(`Olá! Tenho interesse no imóvel ${listing.title} (${listing.id}).`)}
          >
            Agendar visita no WhatsApp
          </a>
          <p>
            <a href="/imoveis">Voltar aos imóveis</a>
          </p>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="Imóvel | Uniplace" noindex={true}>
      <section class="section">
        <div class="container">
          <h1>Imóvel não encontrado</h1>
          <p>
            <a href="/imoveis">Ver imóveis</a>
          </p>
        </div>
      </section>
    </BaseLayout>
  )
}

<style>
  .detail {
    max-width: 44rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-eyebrow);
    color: var(--color-primary);
    font-weight: 600;
  }
  .price {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .meta {
    color: var(--color-neutral-500);
  }
  .hero-img {
    width: 100%;
    border-radius: var(--radius-lg);
    margin: 1rem 0;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-stone);
  }
  .btn {
    display: inline-block;
    margin: 1rem 0;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
</style>
