---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingCard from '../../components/listings/ListingCard.astro';
import { getListings, isMockFeed } from '../../lib/listings';
import { site, waUrl } from '../../config/site';

const listings = getListings();
const isMock = isMockFeed();
---

<BaseLayout
  title={`Imóveis | ${site.name}`}
  description="Apartamentos e coberturas à venda em Belo Horizonte, Nova Lima e Contagem."
>
  <section class="section">
    <div class="container">
      <h1>Imóveis à venda</h1>
      <p class="lead">
        Carteira da Uniplace em {site.markets.join(', ')}. Visita com corretor associado via WhatsApp.
      </p>

      {
        isMock && (
          <p class="banner">
            Feed CRM ainda não conectado (<code>LISTINGS_FEED_URL</code>). Exibindo mock local para desenvolvimento.
          </p>
        )
      }

      {
        listings.length ? (
          <div class="grid">
            {listings.map((listing) => (
              <ListingCard listing={listing} />
            ))}
          </div>
        ) : (
          <p>Nenhum imóvel no feed no momento.</p>
        )
      }

      <div class="actions">
        <a class="btn btn-primary" href={waUrl('Olá! Quero ver imóveis na Uniplace.')}>
          WhatsApp
        </a>
        <a class="btn" href="/alerta">
          Criar alerta
        </a>
        <a class="btn" href="/bairros">
          Bairros
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 48ch;
  }
  .banner {
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--color-accent) 18%, white);
    border-radius: var(--radius-md);
    font-size: var(--text-small);
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn {
    display: inline-block;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    border: 1px solid var(--color-border);
    color: inherit;
  }
</style>
