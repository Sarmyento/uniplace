---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniplaceHero from '../components/sections/UniplaceHero.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import CTASection from '../components/sections/CTASection.astro';
import RevealInit from '../components/sections/RevealInit.astro';
import ListingCard from '../components/listings/ListingCard.astro';
import { getListings } from '../lib/listings';
import { site, waUrl } from '../config/site';

const featured = getListings({ featuredOnly: true, limit: 3 });

const features = [
  {
    title: 'Quero comprar',
    description: 'Imóveis reais em BH, Nova Lima e Contagem. Visita com corretor associado.',
    icon: '/icons/3d/buy.webp',
  },
  {
    title: 'Quero vender',
    description: 'Um cadastro gratuito: site Uniplace, Quinto Andar e corretores associados.',
    icon: '/icons/3d/sell.webp',
  },
  {
    title: 'Quero me associar',
    description: 'Carteira Uniplace, Comunidade CRM e imóveis Quinto Andar. Comissão até 50% bruta. Sem exclusividade.',
    icon: '/icons/3d/visit.webp',
  },
];
---

<BaseLayout
  title={`${site.name} | ${site.tagline}`}
  description="Imobiliária em Belo Horizonte, Nova Lima e Contagem. Comprar, vender ou se associar. Tudo em um só lugar."
>
  <UniplaceHero />

  <section class="section">
    <div class="container paths reveal-stagger">
      <a class="path path-motion" href="/imoveis">
        <img src="/icons/3d/buy.webp" alt="" width="48" height="48" loading="lazy" />
        <h2>Comprar</h2>
        <p>Ver imóveis e agendar visita.</p>
      </a>
      <a class="path path-motion" href="/anunciar">
        <img src="/icons/3d/sell.webp" alt="" width="48" height="48" loading="lazy" />
        <h2>Vender</h2>
        <p>Anunciar com cadastro único.</p>
      </a>
      <a class="path path-motion path--accent" href="/associar">
        <img src="/icons/3d/visit.webp" alt="" width="48" height="48" loading="lazy" />
        <h2>Associar</h2>
        <p>Corretor: cresça com a Uniplace.</p>
      </a>
    </div>
  </section>

  <FeatureGrid
    title="Por que a Uniplace"
    items={features.map((f) => ({ title: f.title, description: f.description, icon: f.icon }))}
  />

  {
    featured.length > 0 && (
      <section class="section">
        <div class="container">
          <span class="motion-line motion-line--wide reveal" aria-hidden="true"></span>
          <h2 class="reveal">Imóveis em destaque</h2>
          <div class="listing-grid reveal-stagger">
            {featured.map((listing) => (
              <ListingCard listing={listing} />
            ))}
          </div>
          <p class="reveal">
            <a href="/imoveis">Ver todos os imóveis</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container about-teaser reveal-up">
      <span class="motion-line motion-line--wide" aria-hidden="true"></span>
      <h2>Imobiliária com corretores associados</h2>
      <p>
        Sócio público: {site.publicPartner}. Atendimento no WhatsApp com a Maria. Equipe de corretores associados,
        sem exclusividade.
      </p>
      <p>
        <a href="/sobre">Conhecer a Uniplace</a>
        ·
        <a href="/bairros">Explorar bairros</a>
        ·
        <a href="/blog">Ler o blog</a>
      </p>
    </div>
  </section>

  <CTASection
    title="Fale com a Maria"
    text="Tire dúvidas, agende visita ou comece seu anúncio."
    ctaLabel="WhatsApp"
    ctaHref={waUrl('Olá! Vim pelo site da Uniplace.')}
  />
  <RevealInit />
</BaseLayout>

<style>
  .listing-grid {
    display: grid;
    gap: 1.25rem;
    margin: 1.25rem 0;
  }
  @media (min-width: 720px) {
    .listing-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .paths {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .paths {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .path {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
  }

  .path img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    margin-bottom: 0.75rem;
  }

  .path h2 {
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-primary);
  }

  .path--accent {
    background: color-mix(in srgb, var(--color-secondary) 12%, var(--color-surface));
  }

  .about-teaser {
    max-width: 42rem;
  }
</style>
