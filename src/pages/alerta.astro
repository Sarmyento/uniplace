---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, waUrl } from '../config/site';
---

<BaseLayout
  title={`Alerta de imóveis | ${site.name}`}
  description="Salve seu filtro e receba imóveis novos compatíveis (radar Uniplace)."
>
  <section class="section">
    <div class="container prose">
      <h1>Alerta de imóveis</h1>
      <p>
        Conte o que você procura (cidade, tipo, faixa de preço e bairros) e a Uniplace avisa quando aparecer um
        imóvel que combine com o seu perfil.
      </p>
      <p>Por enquanto, o pedido de alerta é feito pelo WhatsApp.</p>
      <a class="btn btn-primary" href={waUrl('Olá! Quero criar um alerta de imóveis na Uniplace.')}>
        Pedir alerta no WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 40rem;
  }
  .btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
  }
</style>
