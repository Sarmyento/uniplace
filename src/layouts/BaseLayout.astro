---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import WhatsAppFloat from '../components/global/WhatsAppFloat.astro';
import Tracking from '../components/global/Tracking.astro';
import { site } from '../config/site';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';
import { assetPath } from '../lib/paths';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import dmSans500 from '@fontsource/dm-sans/files/dm-sans-latin-500-normal.woff2?url';
import dmSerif from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${site.name} | ${site.tagline}`,
  description = site.tagline,
  image = '/og-default.svg',
  noindex = import.meta.env.PUBLIC_DEPLOY_TARGET === 'github-pages',
  bodyClass = '',
  jsonLd,
} = Astro.props;

const origin = Astro.site ?? new URL(site.domain);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image.startsWith('http') ? image : assetPath(image), origin).href;

const baseLd = [organizationJsonLd(site, origin.href), websiteJsonLd(site, origin.href)];
const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allLd = [...baseLd, ...pageLd];

const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;
const gtmOrigin = (import.meta.env.PUBLIC_GTM_SERVER_ORIGIN as string | undefined)?.replace(/\/$/, '');
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#C87A5E" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />

    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    <link rel="icon" type="image/png" href={assetPath('/brand/icon-b3.png')} />
    <link rel="preload" as="font" type="font/woff2" href={dmSerif} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSans400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSans500} crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(allLd)} />
    <Tracking />
  </head>
  <body class={bodyClass || undefined}>
    {
      gtmId && gtmOrigin && (
        <noscript>
          <iframe
            src={`${gtmOrigin}/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="gtm"
          />
        </noscript>
      )
    }
    <a class="sr-only" href="#conteudo">Ir para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>

<style is:global>
  main {
    min-height: 60vh;
  }
</style>
