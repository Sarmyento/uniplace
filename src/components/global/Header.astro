---
import { site, nav } from '../../config/site';
import { assetPath, isCurrentPath, sitePath } from '../../lib/paths';

const current = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href={sitePath('/')} aria-label={`${site.name}, início`}>
      <img
        src={assetPath('/brand/wordmark-1c.png')}
        alt=""
        width="190"
        height="54"
        class="logo__wordmark"
        decoding="async"
      />
    </a>
    <nav aria-label="Principal">
      <ul class="nav">
        {
          nav.map((item) => (
            <li>
              <a
                href={sitePath(item.href)}
                aria-current={isCurrentPath(item.href, current) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-neutral-100) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    gap: var(--space-3);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .logo__wordmark {
    display: block;
    height: 2rem;
    width: auto;
    background: transparent;
  }

  @media (min-width: 900px) {
    .logo__wordmark {
      height: 2.35rem;
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: end;
    gap: 0.65rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-weight: 400;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }

  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .nav {
      gap: 0.45rem 0.7rem;
    }
    .nav a {
      font-size: 0.8rem;
    }
    .logo__wordmark {
      height: 1.75rem;
    }
  }
</style>
