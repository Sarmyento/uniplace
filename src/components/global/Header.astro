---
import { site, nav } from '../../config/site';

const current = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/" aria-label={`${site.name} — início`}>
      <img
        src="/icons/3d/brand-b3.webp"
        alt=""
        width="80"
        height="80"
        class="logo__icon"
        decoding="async"
      />
      <img
        src="/icons/3d/wm-uniplace-3d.webp"
        alt={site.name}
        width="180"
        height="48"
        class="logo__wordmark"
        decoding="async"
      />
    </a>
    <nav aria-label="Principal">
      <ul class="nav">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  current === item.href || (item.href !== '/' && current.startsWith(item.href))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-neutral-100) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    gap: var(--space-3);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--color-ink);
  }

  /* Ícone ~30% maior que a base compacta (48→62 / 52→68) */
  .logo__icon {
    width: 62px;
    height: 62px;
    object-fit: contain;
    flex-shrink: 0;
    background: transparent;
  }

  .logo__wordmark {
    height: 30px;
    width: auto;
    max-width: min(168px, 38vw);
    display: block;
    object-fit: contain;
    object-position: left center;
    background: transparent;
  }

  @media (min-width: 900px) {
    .logo__icon {
      width: 68px;
      height: 68px;
    }
    .logo__wordmark {
      height: 34px;
      max-width: 190px;
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.65rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-weight: 400;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
  }

  .nav a:hover {
    color: var(--color-primary);
  }

  .nav a[aria-current='page'] {
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .nav {
      gap: 0.45rem 0.7rem;
    }
    .nav a {
      font-size: 0.8rem;
    }
    .logo__icon {
      width: 52px;
      height: 52px;
    }
    .logo__wordmark {
      height: 26px;
    }
  }
</style>
