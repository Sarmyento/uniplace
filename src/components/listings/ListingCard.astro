---
import type { Listing } from '../../lib/listings';
import { formatListingAddress } from '../../lib/listings';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const href = `/imoveis/${listing.slug}`;
const address = formatListingAddress(listing);

const specs = [
  { icon: '/icons/3d/bed.webp', value: listing.bedrooms, label: 'quartos', show: listing.bedrooms > 0 },
  { icon: '/icons/3d/suite.webp', value: listing.suites, label: 'suítes', show: listing.suites > 0 },
  { icon: '/icons/3d/area.webp', value: listing.area ? `${listing.area}` : '', label: 'm²', show: listing.area > 0 },
  { icon: '/icons/3d/garage.webp', value: listing.parking, label: 'vagas', show: listing.parking > 0 },
].filter((s) => s.show);
---

<article class="listing-card card-hover">
  <a class="listing-card__link" href={href}>
    <div class="listing-card__media card-hover__media">
      {
        listing.image ? (
          <img
            class="listing-card__photo"
            src={listing.image}
            alt=""
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="listing-card__placeholder" aria-hidden="true" />
        )
      }
      {listing.type && <span class="listing-card__type">{listing.type}</span>}
      {
        specs.length > 0 && (
          <ul class="listing-card__specs" aria-label="Características">
            {specs.map((spec) => (
              <li>
                <img src={spec.icon} alt="" width="28" height="28" loading="lazy" decoding="async" />
                <span>
                  <strong>{spec.value}</strong> {spec.label}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="listing-card__body">
      <p class="listing-card__location">{address || `${listing.neighborhood}, ${listing.city}`}</p>
      <h3 class="listing-card__title">{listing.title}</h3>
      <p class="listing-card__price">{listing.price}</p>
    </div>
  </a>
</article>

<style>
  .listing-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .listing-card__link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .listing-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-stone);
  }

  .listing-card__media .listing-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .listing-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-stone), var(--color-secondary-light));
  }

  .listing-card__type {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 2;
    background: color-mix(in srgb, var(--color-neutral-900) 82%, transparent);
    color: #fff;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .listing-card__specs {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0.65rem 0.75rem;
    background: linear-gradient(180deg, transparent, rgb(45 45 45 / 0.72));
    color: #fff;
  }

  .listing-card__specs li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
  }

  .listing-card__specs img {
    width: 1.35rem;
    height: 1.35rem;
    object-fit: contain;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .listing-card__specs strong {
    font-weight: 600;
  }

  .listing-card__body {
    padding: 1rem 1.1rem 1.15rem;
  }

  .listing-card__location {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
    margin: 0 0 0.35rem;
  }

  .listing-card__title {
    font-size: 1.15rem;
    font-weight: 400;
    margin: 0 0 0.5rem;
    color: var(--color-neutral-900);
    line-height: 1.35;
  }

  .listing-card__price {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-primary);
    margin: 0;
  }
</style>
