---
import type { Listing } from '../../lib/listings';
import { formatListingAddress } from '../../lib/listings';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const href = `/imoveis/${listing.slug}`;
const address = formatListingAddress(listing);

const meta = [
  listing.bedrooms ? `${listing.bedrooms} quartos` : '',
  listing.suites ? `${listing.suites} suítes` : '',
  listing.area ? `${listing.area} m²` : '',
  listing.parking ? `${listing.parking} vagas` : '',
]
  .filter(Boolean)
  .join(' · ');
---

<article class="listing-card card-hover">
  <a class="listing-card__link" href={href}>
    <div class="listing-card__media card-hover__media">
      {
        listing.image ? (
          <img
            class="listing-card__photo"
            src={listing.image}
            alt=""
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="listing-card__placeholder" aria-hidden="true" />
        )
      }
      {listing.type && <span class="listing-card__type">{listing.type}</span>}
    </div>
    <div class="listing-card__body">
      <p class="listing-card__location">{address || `${listing.neighborhood}, ${listing.city}`}</p>
      <h3 class="listing-card__title">{listing.title}</h3>
      {meta && <p class="listing-card__meta">{meta}</p>}
      <p class="listing-card__price">{listing.price}</p>
    </div>
  </a>
</article>

<style>
  .listing-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .listing-card__link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .listing-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-stone);
  }

  .listing-card__media .listing-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .listing-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-stone), var(--color-secondary-light));
  }

  .listing-card__type {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 2;
    background: color-mix(in srgb, var(--color-neutral-900) 82%, transparent);
    color: #fff;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .listing-card__body {
    padding: 1rem 1.1rem 1.15rem;
  }

  .listing-card__location {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.35rem;
  }

  .listing-card__title {
    font-size: 1.15rem;
    font-weight: 400;
    margin: 0 0 0.4rem;
    color: var(--color-ink);
    line-height: 1.35;
  }

  .listing-card__meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0 0 0.55rem;
  }

  .listing-card__price {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-primary);
    margin: 0;
  }
</style>
