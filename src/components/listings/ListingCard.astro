---
import type { Listing } from '../../lib/listings';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const href = `/imoveis/${listing.slug}`;
const address = [listing.street, listing.neighborhood].filter(Boolean).join(', ');

const meta = [
  listing.bedrooms ? `${listing.bedrooms} quartos` : '',
  listing.suites ? `${listing.suites} suítes` : '',
  listing.area ? `${listing.area} m²` : '',
  listing.parking ? `${listing.parking} vagas` : '',
]
  .filter(Boolean)
  .join(' · ');
---

<article class="listing-card card-hover">
  <a class="listing-card__link" href={href}>
    <div class="listing-card__media card-hover__media">
      {
        listing.image ? (
          <img
            class="listing-card__photo"
            src={listing.image}
            alt=""
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="listing-card__placeholder" aria-hidden="true" />
        )
      }
      {listing.type && <span class="listing-card__type">{listing.type}</span>}
    </div>
    <div class="listing-card__body">
      {address && <p class="listing-card__location">{address}</p>}
      <h3 class="listing-card__title">{listing.title}</h3>
      {meta && <p class="listing-card__meta">{meta}</p>}
      <p class="listing-card__price">{listing.price}</p>
    </div>
  </a>
</article>

<style>
  .listing-card {
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .listing-card__link {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .listing-card__media {
    position: relative;
    flex: 0 0 auto;
    aspect-ratio: 16 / 10;
    height: auto;
    overflow: hidden;
    background: var(--color-stone);
  }

  .listing-card__media .listing-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .listing-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-stone), var(--color-secondary-light));
  }

  .listing-card__type {
    position: absolute;
    left: 0.5rem;
    top: 0.5rem;
    z-index: 2;
    background: color-mix(in srgb, var(--color-ink) 78%, transparent);
    color: #fff;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    padding: 0.28rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .listing-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 7.75rem;
    padding: 0.7rem 0.8rem 0.8rem;
  }

  .listing-card__location {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listing-card__title {
    font-size: 0.95rem;
    font-weight: 400;
    margin: 0 0 0.3rem;
    color: var(--color-ink);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.5em;
  }

  .listing-card__meta {
    color: var(--color-muted);
    font-size: 0.75rem;
    margin: 0 0 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listing-card__price {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--color-primary);
    margin: 0.45rem 0 0;
  }
</style>
