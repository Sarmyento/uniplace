---
import type { Listing } from '../../lib/listings';
import { formatListingAddress } from '../../lib/listings';

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const href = `/imoveis/${listing.slug}`;
const meta = [
  listing.bedrooms ? `${listing.bedrooms} quartos` : '',
  listing.area ? `${listing.area} m²` : '',
  listing.parking ? `${listing.parking} vagas` : '',
]
  .filter(Boolean)
  .join(' · ');
---

<article class="card">
  <a href={href}>
    <div class="media">
      {
        listing.image ? (
          <img src={listing.image} alt="" width="640" height="400" loading="lazy" />
        ) : (
          <div class="placeholder" aria-hidden="true" />
        )
      }
      <span class="type">{listing.type}</span>
    </div>
    <div class="body">
      <p class="loc">{formatListingAddress(listing)}</p>
      <h3>{listing.title}</h3>
      {meta && <p class="meta">{meta}</p>}
      <p class="price">{listing.price}</p>
    </div>
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
  }
  .card a {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-stone);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-stone), var(--color-secondary-light, #a4b1a1));
  }
  .type {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    background: rgb(45 45 45 / 0.85);
    color: #fff;
    font-size: var(--text-small);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }
  .body {
    padding: 1rem;
  }
  .loc {
    font-size: var(--text-small);
    color: var(--color-neutral-500);
    margin: 0 0 0.35rem;
  }
  h3 {
    font-size: 1.15rem;
    margin: 0 0 0.35rem;
  }
  .meta {
    font-size: var(--text-small);
    margin: 0 0 0.5rem;
  }
  .price {
    font-weight: 600;
    color: var(--color-primary);
    margin: 0;
  }
</style>
