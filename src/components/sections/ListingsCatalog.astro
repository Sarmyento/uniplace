---
import ListingCard from '../listings/ListingCard.astro';
import type { Listing } from '../../lib/listings';
import { getListingFilterOptions } from '../../lib/listings';

interface Props {
  listings: Listing[];
}

const { listings } = Astro.props;
const { cities, neighborhoods, types, amenities } = getListingFilterOptions(listings);
const locationSeed = [
  ...cities.map((name) => ({
    name,
    kind: 'cidade' as const,
    city: name,
    label: name,
  })),
  ...neighborhoods.map(({ name, city }) => ({
    name,
    kind: 'bairro' as const,
    city,
    label: city ? `${name}, ${city}` : name,
  })),
];
---

<section class="listings-catalog" id="filtros" aria-labelledby="filtros-title">
  <div class="filters-sticky">
    <div class="container">
      <div class="filters-bar">
        <h2 id="filtros-title" class="visually-hidden">Filtros de imóveis</h2>

        <form class="filters-form" data-listings-filter aria-labelledby="filtros-title">
          <div class="filters-form__primary">
            <div
              class="location-select"
              data-location-select
              data-seed={JSON.stringify(locationSeed)}
            >
              <span class="visually-hidden">Localização</span>
              <div class="location-select__box" data-location-box>
                <div class="location-select__chips" data-location-chips></div>
                <input
                  type="text"
                  class="location-select__input"
                  data-location-input
                  placeholder="Localização"
                  autocomplete="off"
                  spellcheck="false"
                  inputmode="search"
                  aria-label="Localização"
                  aria-autocomplete="list"
                  aria-controls="location-suggestions"
                  aria-expanded="false"
                />
              </div>
              <ul
                id="location-suggestions"
                class="location-select__suggestions"
                data-location-suggestions
                hidden
                role="listbox"
              ></ul>
              <div data-location-hidden></div>
            </div>

            <div class="multi-select" data-multi-select="type">
              <span class="visually-hidden">Tipo</span>
              <button
                type="button"
                class="multi-select__trigger"
                data-multi-select-trigger
                data-empty-label="Tipo"
                aria-label="Tipo de imóvel"
              >
                Tipo
              </button>
              <div class="multi-select__dropdown" data-multi-select-dropdown hidden>
                {
                  types.map((t) => (
                    <label class="multi-select__option">
                      <input type="checkbox" name="type" value={t} />
                      <span>{t}</span>
                    </label>
                  ))
                }
              </div>
            </div>

            <label class="filters-form__field">
              <span class="visually-hidden">Quartos</span>
              <select name="bedrooms" aria-label="Quartos">
                <option value="">Quartos</option>
                <option value="1">1+</option>
                <option value="2">2+</option>
                <option value="3">3+</option>
                <option value="4">4+</option>
                <option value="5">5+</option>
              </select>
            </label>

            <button
              type="button"
              class="filters-form__toggle"
              data-filters-toggle
              aria-expanded="false"
              aria-controls="filters-more"
            >
              <span data-filters-toggle-label>Mais</span>
              <svg class="filters-form__toggle-icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M3.5 5.25 7 8.75l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>

          <div class="filters-form__more" id="filters-more" data-filters-more hidden>
            <label class="filters-form__field">
              <span class="filters-form__label">Preço mín.</span>
              <input type="number" name="priceMin" min="0" step="100000" placeholder="500000" inputmode="numeric" />
            </label>

            <label class="filters-form__field">
              <span class="filters-form__label">Preço máx.</span>
              <input type="number" name="priceMax" min="0" step="100000" placeholder="2000000" inputmode="numeric" />
            </label>

            <label class="filters-form__field">
              <span class="filters-form__label">Área mín.</span>
              <input type="number" name="areaMin" min="0" step="10" placeholder="80" inputmode="numeric" />
            </label>

            <label class="filters-form__field">
              <span class="filters-form__label">Banheiros</span>
              <select name="bathrooms" aria-label="Banheiros">
                <option value="">Qualquer</option>
                <option value="1">1+</option>
                <option value="2">2+</option>
                <option value="3">3+</option>
                <option value="4">4+</option>
              </select>
            </label>

            <div class="multi-select filters-form__amenities" data-multi-select="amenities">
              <span class="filters-form__label">Comodidades</span>
              <button
                type="button"
                class="multi-select__trigger"
                data-multi-select-trigger
                data-empty-label="Comodidades"
                aria-label="Comodidades"
              >
                Comodidades
              </button>
              <div class="multi-select__dropdown" data-multi-select-dropdown hidden>
                {
                  amenities.map((item) => (
                    <label class="multi-select__option">
                      <input type="checkbox" name="amenity" value={item} />
                      <span>{item}</span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div class="filters-form__actions">
              <button class="btn btn-primary btn-motion" type="submit">Aplicar</button>
              <button class="btn btn-secondary btn-motion filters-form__reset" type="reset">Limpar</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="container listings-catalog__body">
    <div class="listings-grid" data-listings-grid>
      {
        listings.map((listing) => (
          <div
            class="listings-grid__item"
            data-listing-item
            data-title={listing.title.toLowerCase()}
            data-id={listing.id.toLowerCase()}
            data-neighborhood={listing.neighborhood}
            data-city={listing.city}
            data-type={listing.type}
            data-bedrooms={listing.bedrooms}
            data-bathrooms={listing.bathrooms}
            data-price={listing.priceValue}
            data-area={listing.area}
            data-amenities={listing.amenities.join('|')}
          >
            <ListingCard listing={listing} />
          </div>
        ))
      }
    </div>

    <div class="listings-pagination">
      <button class="btn btn-primary btn-motion" data-load-more hidden aria-label="Exibir mais imóveis">
        Exibir mais 15 imóveis
      </button>
    </div>

    <p class="listings-empty" data-listings-empty hidden>
      Nenhum imóvel corresponde aos filtros. Ajuste a busca ou fale no WhatsApp.
    </p>
  </div>
</section>

<script>
  const PAGE_SIZE = 15;
  const form = document.querySelector('[data-listings-filter]');
  const items = [...document.querySelectorAll('[data-listing-item]')];
  const emptyEl = document.querySelector('[data-listings-empty]');
  const gridEl = document.querySelector('[data-listings-grid]');
  const loadMoreBtn = document.querySelector('[data-load-more]');

  let visibleLimit = PAGE_SIZE;

  /* ---- Multi-select (tipo, comodidades) ---- */
  document.querySelectorAll('[data-multi-select]').forEach((container) => {
    const trigger = container.querySelector('[data-multi-select-trigger]');
    const dropdown = container.querySelector('[data-multi-select-dropdown]');
    const checkboxes = dropdown?.querySelectorAll('input[type="checkbox"]') ?? [];
    const emptyLabel = trigger?.getAttribute('data-empty-label') || 'Todos';

    function updateTriggerText() {
      const checked = [...checkboxes].filter((cb) => cb.checked);
      if (trigger) {
        trigger.textContent = checked.length
          ? `${checked.length} selecionado${checked.length === 1 ? '' : 's'}`
          : emptyLabel;
      }
    }

    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !dropdown?.hasAttribute('hidden');
      document.querySelectorAll('[data-multi-select-dropdown]').forEach((d) => d.setAttribute('hidden', ''));
      document.querySelectorAll('[data-location-suggestions]').forEach((d) => d.setAttribute('hidden', ''));
      dropdown?.toggleAttribute('hidden', isOpen);
    });

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        updateTriggerText();
        visibleLimit = PAGE_SIZE;
        applyFilters();
      });
    });

    document.addEventListener('click', (e) => {
      if (!container.contains(e.target)) dropdown?.setAttribute('hidden', '');
    });
  });

  /* ---- Expandir / recolher filtros extras ---- */
  const filtersMore = document.querySelector('[data-filters-more]');
  const filtersToggle = document.querySelector('[data-filters-toggle]');
  const filtersToggleLabel = document.querySelector('[data-filters-toggle-label]');

  filtersToggle?.addEventListener('click', () => {
    const isOpen = !filtersMore?.hasAttribute('hidden');
    filtersMore?.toggleAttribute('hidden', isOpen);
    filtersToggle.setAttribute('aria-expanded', String(!isOpen));
    filtersToggle.classList.toggle('is-open', !isOpen);
    if (filtersToggleLabel) filtersToggleLabel.textContent = isOpen ? 'Mais' : 'Menos';
  });

  /* ---- Localização: multi-select + autocomplete ≥3 chars ---- */
  const locationRoot = document.querySelector('[data-location-select]');
  /** @type {{ name: string, kind: 'cidade' | 'bairro', city?: string, label?: string }[]} */
  let selectedLocations = [];

  function syncLocationHidden() {
    const holder = locationRoot?.querySelector('[data-location-hidden]');
    if (!holder) return;
    holder.innerHTML = '';
    selectedLocations.forEach((loc) => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = loc.kind === 'cidade' ? 'city' : 'neighborhood';
      input.value = loc.name;
      holder.appendChild(input);
    });
  }

  function renderLocationChips() {
    const chips = locationRoot?.querySelector('[data-location-chips]');
    if (!chips) return;
    chips.innerHTML = '';
    selectedLocations.forEach((loc, index) => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'location-select__chip';
      const label = loc.label || loc.name;
      chip.innerHTML = `<span>${label}</span><span aria-hidden="true">×</span>`;
      chip.setAttribute('aria-label', `Remover ${label}`);
      chip.addEventListener('click', () => {
        selectedLocations.splice(index, 1);
        renderLocationChips();
        syncLocationHidden();
        visibleLimit = PAGE_SIZE;
        applyFilters();
      });
      chips.appendChild(chip);
    });
  }

  function normalizeText(value) {
    return String(value || '')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/\p{M}/gu, '');
  }

  if (locationRoot) {
    const seed = JSON.parse(locationRoot.getAttribute('data-seed') || '[]');
    const input = locationRoot.querySelector('[data-location-input]');
    const suggestions = locationRoot.querySelector('[data-location-suggestions]');
    const box = locationRoot.querySelector('[data-location-box]');

    function closeSuggestions() {
      suggestions?.setAttribute('hidden', '');
      input?.setAttribute('aria-expanded', 'false');
    }

    function openSuggestions(matches) {
      if (!suggestions) return;
      suggestions.innerHTML = '';
      if (!matches.length) {
        closeSuggestions();
        return;
      }
      matches.forEach((item) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.className = 'location-select__suggestion';
        li.textContent = item.label || item.name;
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          const exists = selectedLocations.some((s) => s.name === item.name && s.kind === item.kind);
          if (!exists) {
            selectedLocations.push(item);
            renderLocationChips();
            syncLocationHidden();
            visibleLimit = PAGE_SIZE;
            applyFilters();
          }
          if (input) input.value = '';
          closeSuggestions();
        });
        suggestions.appendChild(li);
      });
      suggestions.removeAttribute('hidden');
      input?.setAttribute('aria-expanded', 'true');
    }

    input?.addEventListener('input', () => {
      const q = normalizeText(input.value);
      if (q.length < 3) {
        closeSuggestions();
        return;
      }
      const matches = seed
        .filter((item) => {
          const haystack = normalizeText(item.label || item.name);
          const already = selectedLocations.some((s) => s.name === item.name && s.kind === item.kind);
          return !already && haystack.includes(q);
        })
        .slice(0, 12);
      openSuggestions(matches);
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace' && !input.value && selectedLocations.length) {
        selectedLocations.pop();
        renderLocationChips();
        syncLocationHidden();
        visibleLimit = PAGE_SIZE;
        applyFilters();
      }
      if (e.key === 'Escape') closeSuggestions();
    });

    document.addEventListener('click', (e) => {
      if (!locationRoot.contains(e.target)) closeSuggestions();
    });

    box?.addEventListener('click', () => input?.focus());
  }

  function applyFilters() {
    if (!form) return;
    const data = new FormData(form);
    const cities = data.getAll('city').filter(Boolean);
    const neighborhoods = data.getAll('neighborhood').filter(Boolean);
    const types = data.getAll('type').filter(Boolean);
    const selectedAmenities = data.getAll('amenity').filter(Boolean);
    const bedrooms = Number(data.get('bedrooms') || 0);
    const bathrooms = Number(data.get('bathrooms') || 0);
    const priceMin = Number(data.get('priceMin') || 0);
    const priceMax = Number(data.get('priceMax') || 0);
    const areaMin = Number(data.get('areaMin') || 0);

    let visible = 0;
    for (const item of items) {
      const itemCity = item.getAttribute('data-city') ?? '';
      const itemNeighborhood = item.getAttribute('data-neighborhood') ?? '';
      const itemType = item.getAttribute('data-type') ?? '';
      const itemBedrooms = Number(item.getAttribute('data-bedrooms') ?? 0);
      const itemBathrooms = Number(item.getAttribute('data-bathrooms') ?? 0);
      const itemPrice = Number(item.getAttribute('data-price') ?? 0);
      const itemArea = Number(item.getAttribute('data-area') ?? 0);
      const itemAmenities = (item.getAttribute('data-amenities') ?? '')
        .split('|')
        .map((value) => value.trim())
        .filter(Boolean);

      const matchesLocation =
        (cities.length === 0 && neighborhoods.length === 0) ||
        cities.includes(itemCity) ||
        neighborhoods.includes(itemNeighborhood);

      const matchesAmenities =
        selectedAmenities.length === 0 ||
        selectedAmenities.every((amenity) => itemAmenities.includes(amenity));

      const show =
        matchesLocation &&
        matchesAmenities &&
        (types.length === 0 || types.includes(itemType)) &&
        (!bedrooms || itemBedrooms >= bedrooms) &&
        (!bathrooms || itemBathrooms >= bathrooms) &&
        (!priceMin || itemPrice >= priceMin) &&
        (!priceMax || itemPrice <= priceMax) &&
        (!areaMin || itemArea >= areaMin);

      item.dataset.filtered = show ? 'true' : 'false';
      if (show) visible += 1;
    }
    renderVisible();
    updateEmptyState(visible);
  }

  function renderVisible() {
    const visibleItems = items.filter((item) => item.dataset.filtered === 'true');
    let shown = 0;
    for (const item of items) {
      const filtered = item.dataset.filtered === 'true';
      if (filtered && shown < visibleLimit) {
        item.removeAttribute('hidden');
        shown += 1;
      } else {
        item.setAttribute('hidden', '');
      }
    }
    const remaining = visibleItems.length - shown;
    if (loadMoreBtn) {
      if (remaining > 0) {
        const nextBatch = Math.min(remaining, PAGE_SIZE);
        loadMoreBtn.textContent = `Exibir mais ${nextBatch} imóvel${nextBatch === 1 ? '' : 'es'}`;
        loadMoreBtn.removeAttribute('hidden');
      } else {
        loadMoreBtn.setAttribute('hidden', '');
      }
    }
  }

  function updateEmptyState(visible) {
    emptyEl?.toggleAttribute('hidden', visible > 0);
    gridEl?.toggleAttribute('hidden', visible === 0);
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    visibleLimit = PAGE_SIZE;
    applyFilters();
  });

  form?.addEventListener('reset', () => {
    selectedLocations = [];
    renderLocationChips();
    syncLocationHidden();
    const locInput = locationRoot?.querySelector('[data-location-input]');
    if (locInput) locInput.value = '';
    document.querySelectorAll('[data-multi-select] input[type="checkbox"]').forEach((cb) => {
      cb.checked = false;
    });
    document.querySelectorAll('[data-multi-select-trigger]').forEach((btn) => {
      btn.textContent = btn.getAttribute('data-empty-label') || 'Todos';
    });
    visibleLimit = PAGE_SIZE;
    window.setTimeout(applyFilters, 0);
  });

  form?.querySelectorAll('select, input[type="number"]').forEach((field) => {
    field.addEventListener('change', () => {
      visibleLimit = PAGE_SIZE;
      applyFilters();
    });
  });

  loadMoreBtn?.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    renderVisible();
    updateEmptyState(items.filter((item) => item.dataset.filtered === 'true').length);
  });

  items.forEach((item) => {
    item.dataset.filtered = 'true';
  });
  applyFilters();

  if (window.location.hash === '#filtros') {
    document.getElementById('filtros')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>

<style>
  .listings-catalog {
    padding-bottom: 2.5rem;
  }

  .filters-sticky {
    position: sticky;
    top: var(--header-height);
    z-index: 40;
    padding: 0.45rem 0 0.55rem;
    background: color-mix(in srgb, var(--color-background) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .listings-catalog__body {
    padding-top: 1.15rem;
  }

  .filters-bar {
    padding: 0.45rem 0.65rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 14px rgb(63 59 55 / 0.06);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .filters-form {
    display: grid;
    gap: 0.55rem;
  }

  .filters-form__primary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .filters-form__primary > .location-select {
    flex: 1 1 11rem;
    min-width: 9rem;
  }

  .filters-form__primary > .multi-select {
    flex: 0 0 6.75rem;
  }

  .filters-form__primary > .filters-form__field {
    flex: 0 0 5.75rem;
  }

  .filters-form__toggle {
    flex: 0 0 auto;
  }

  .filters-form__more {
    display: grid;
    gap: 0.45rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--color-border);
    grid-template-columns: minmax(0, 1fr);
  }

  .filters-form__more[hidden] {
    display: none;
  }

  @media (min-width: 720px) {
    .filters-form__more {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
    }

    .filters-form__amenities {
      grid-column: 1 / -1;
    }

    .filters-form__actions {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .filters-form__more {
      grid-template-columns: repeat(4, minmax(0, 0.85fr)) minmax(12rem, 1.4fr) auto;
    }

    .filters-form__amenities,
    .filters-form__actions {
      grid-column: auto;
    }
  }

  .filters-form__label {
    display: block;
    margin-bottom: 0.18rem;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .filters-form__field {
    display: grid;
    min-width: 0;
  }

  .filters-form input,
  .filters-form select,
  .multi-select__trigger,
  .filters-form__toggle {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.38rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-stone);
    color: var(--color-ink-soft);
    min-height: 2rem;
  }

  .filters-form input[type='number'] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .filters-form input[type='number']::-webkit-outer-spin-button,
  .filters-form input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .filters-form input::placeholder {
    color: var(--color-muted);
  }

  .filters-form__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    cursor: pointer;
    white-space: nowrap;
    color: var(--color-ink-soft);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .filters-form__toggle:hover {
    border-color: color-mix(in srgb, var(--color-ink) 18%, var(--color-border));
  }

  .filters-form__toggle.is-open .filters-form__toggle-icon {
    transform: rotate(180deg);
  }

  .filters-form__toggle-icon {
    display: block;
    transition: transform 0.18s ease;
  }

  .filters-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: end;
  }

  .filters-form__actions .btn {
    padding: 0.38rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .filters-form__reset {
    color: var(--color-ink-soft);
  }

  .location-select {
    position: relative;
    min-width: 0;
  }

  .location-select__box {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.28rem;
    min-height: 2rem;
    max-height: 2rem;
    overflow-x: auto;
    padding: 0.22rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-stone);
    cursor: text;
  }

  .location-select__chips {
    display: contents;
  }

  .location-select__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex: 0 0 auto;
    padding: 0.12rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink-soft);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .location-select__input {
    flex: 1 1 8rem;
    min-width: 7rem;
    border: none !important;
    background: transparent !important;
    padding: 0.2rem 0.15rem !important;
    min-height: auto !important;
    font-size: 0.82rem !important;
    outline: none;
    box-shadow: none;
  }

  .location-select__input::-webkit-search-decoration,
  .location-select__input::-webkit-search-cancel-button,
  .location-select__input::-webkit-search-results-button,
  .location-select__input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .location-select__suggestions {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 2px);
    z-index: 45;
    margin: 0;
    padding: 0.25rem 0;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    max-height: 200px;
    overflow-y: auto;
  }

  .location-select__suggestion {
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    color: var(--color-ink-soft);
    font-size: 0.85rem;
  }

  .location-select__suggestion:hover {
    background: var(--color-stone);
    color: var(--color-ink);
  }

  .multi-select {
    position: relative;
    display: grid;
