---
import { assetPath } from '../../lib/paths';

interface Item {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  title?: string;
  items: Item[];
}

const { title = 'Por que nos escolher', items } = Astro.props;

const resolved = items.map((item) => ({
  ...item,
  icon: item.icon ? assetPath(item.icon) : undefined,
}));
---

<section class="section">
  <div class="container">
    <span class="motion-line motion-line--wide reveal" aria-hidden="true"></span>
    <h2 class="reveal">{title}</h2>
    <ul class="grid reveal-stagger">
      {
        resolved.map((item) => (
          <li class="card path-motion">
            {item.icon && <img src={item.icon} alt="" width="48" height="48" loading="lazy" />}
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-border);
  }

  .card img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    margin-bottom: 0.65rem;
  }

  .card h3 {
    color: var(--color-primary);
    font-weight: 400;
  }
</style>
